# Every key is optional: a missing key just turns that feature off.
# Deezer search and the built-in lyrics index work with no keys at all.

# Claude captions photos and picks and orders the playlist. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Backup photo captioning when there's no Anthropic key (needs Inference Providers credits).
# https://huggingface.co/settings/tokens
HF_TOKEN=
# HF_CAPTION_MODEL=google/gemma-4-26B-A4B-it

# TikTok hashtag sounds via an Apify scraper (paid per result). https://console.apify.com/settings/integrations
APIFY_TOKEN=
# APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
# TIKTOK_RESULTS_PER_HASHTAG=20

# Last.fm tag charts. https://www.last.fm/api/account/create
LASTFM_API_KEY=
# Genius title/lyric search. https://genius.com/api-clients (use the "client access token")
GENIUS_ACCESS_TOKEN=

# Spotify: track lookup (server) and "Save to Spotify" (browser login).
# https://developer.spotify.com/dashboard - add redirect URIs https://<your-domain>/ and http://127.0.0.1:3000/
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
